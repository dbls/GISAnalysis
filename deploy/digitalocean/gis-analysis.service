[Unit]
Description=GIS Satellite Analysis API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=gisapp
Group=gisapp
WorkingDirectory=/var/www/gis-analysis/backend
Environment="PATH=/var/www/gis-analysis/backend/venv/bin"
EnvironmentFile=/var/www/gis-analysis/backend/.env
ExecStart=/var/www/gis-analysis/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=10

# Security settings
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=append:/var/log/gis-analysis/access.log
StandardError=append:/var/log/gis-analysis/error.log

[Install]
WantedBy=multi-user.target
